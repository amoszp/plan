# Copy this file to .env and fill in real values. Never commit .env.
PORT=4480
DB_PATH=/app/data/homeblock.db

# Shared accounts service. Same token as its SERVICE_TOKEN.
ACCOUNTS_URL=http://accounts:4600
ACCOUNTS_SERVICE_TOKEN=
# Set to false only for local development over plain http.
COOKIE_SECURE=true

# Companion apps on the same private network, reached with the signed-in user's own token.
# Gym log API (workouts, sets, routines) and shopping-list API (lists, items).
GYMAKER_URL=http://gymaker-server:4481
MERCHECK_URL=http://mercheck:4480

# Food log product lookup (optional overrides; these are the defaults).
# STORE_API_URL=https://tienda.mercadona.es/api/products/
# OFF_API_URL=https://world.openfoodfacts.org/api/v2/product/
# Product search: the store's catalogue for one warehouse, copied by the server once a day.
# STORE_CAT_URL=https://tienda.mercadona.es/api/categories/
# STORE_WH=2717
